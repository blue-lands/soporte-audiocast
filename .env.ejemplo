# Copiar a .env (chmod 600, dueño root). systemd lo lee como root y pasa las variables a la app.

# Base de datos. En el servicio: el StateDirectory de systemd.
SOPORTE_DB=/var/lib/soporte-audiocast/soporte.db

# Central de Audiocast. La app SOLO hace GET /api/units.
CENTRAL_URL=http://127.0.0.1:9000
# Token de operador con nombre propio (`soporte`). Lo crea la instancia de MediaFlow con el OK de hrm.
CENTRAL_TOKEN=
# Mientras no haya token: un JSON con la forma de /api/units. Si tiene valor, NO se consulta la central.
# Cuando llegue el token: poner CENTRAL_TOKEN y dejar esto vacío.
CENTRAL_ARCHIVO=/var/www/soporte-audiocast/ejemplos/units-mixto.json

# Cajas que la app no ve nunca, separadas por coma.
SOPORTE_CAJAS_OCULTAS=nataniel-cox-01

# Panel. No tiene entrada propia: entra quien tiene sesión abierta en la central (misma galleta, mismo dominio).
# Hosts por los que se atiende, separados por coma.
SOPORTE_HOSTS=central.mediaflow.cl,127.0.0.1,localhost
# Dónde se publica dentro del dominio. nginx quita el prefijo al entrar y la app lo pone al salir. Vacío: dominio propio.
SOPORTE_PREFIJO=/soporte
# Dirección pública del panel, para el enlace de los avisos. Vacío: el aviso va sin enlace.
SOPORTE_BASE_URL=https://central.mediaflow.cl/soporte

# Lo que manda ElevenLabs en X-Soporte-Token al usar la herramienta. Generar: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SOPORTE_HERRAMIENTA_TOKEN=
# Secreto HMAC del webhook de fin de conversación: lo entrega ElevenLabs al crear el webhook (F3).
ELEVENLABS_WEBHOOK_SECRET=

# Aviso de casos urgentes por Telegram. Vacío: no se avisa.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
